{
  "name": "ai-sports-agent-contract-analyzer-backend",
  "version": "1.0.0",
  "description": "Backend API for AI Sports Agent Contract Analyzer",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "psql $DATABASE_URL -f src/db/schema.sql",
    "db:seed": "psql $DATABASE_URL -f src/db/seed.sql",
    "db:setup": "npm run db:init && npm run db:seed"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.4.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
